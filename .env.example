# ─── Anthropic ────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Pappers MCP ──────────────────────────────────────────────
# URL complète construite côté serveur : https://mcp.pappers.fr/${PAPPERS_API_KEY}
PAPPERS_API_KEY=

# ─── ElevenLabs (stretch S10) ─────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_GAELLE=tKaoyJLW05zqV0tIH9FD
ELEVENLABS_VOICE_GUILLAUME=ohItIVrXTBI80RrUECOD
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ─── Feature flags ────────────────────────────────────────────
# S10 — voice mode conversationnel (Eleven Agents). À ``true``
# uniquement après merge S10 + gating respecté. Désactivable à chaud
# sans redeploy (Railway env var).
ENABLE_VOICE_MODE=false

# ─── ElevenLabs Agent (stretch S10) ───────────────────────────
# ID public de l'agent créé dans le dashboard ElevenLabs (format
# ``agent_xxxxxxxxxxxxxxxxxxxxx``). Pas un secret — visible côté
# widget JS. La sécurité passe par le domain allowlist côté ElevenLabs.
ELEVEN_AGENT_ID=
# Token partagé Workspace Secret ElevenLabs ↔ endpoint custom LLM.
# 32+ chars random (``python -c "import secrets; print(secrets.token_urlsafe(32))"``).
# Vérifié timing-safe côté middleware ``voice/security.py`` —
# secret strict, ne JAMAIS commit, ne JAMAIS logger.
ELEVEN_AGENT_SHARED_TOKEN=

# ─── Observabilité ────────────────────────────────────────────
LOG_LEVEL=INFO
# Optionnel : si défini, /stats exige ``Authorization: Bearer <STATS_TOKEN>``
# (recommandé en prod Railway). Laisser vide en dev pour curl direct.
# Recommandation : 32+ caractères alphanumériques aléatoires
# (``python -c "import secrets; print(secrets.token_urlsafe(32))"``).
# Comparaison timing-safe via hmac.compare_digest côté handler.
# STATS_TOKEN=

# ─── Railway (déploiement S08) ────────────────────────────────
# Token Account-scope (créer via railway.com/account/tokens, dropdown
# Workspace = "No workspace" → scope = Account). Permet à un Dev /
# Review Agent S08+ d'introspecter les déploiements via la GraphQL API
# (https://backboard.railway.com/graphql/v2 + Authorization: Bearer).
# Stocké uniquement dans .env local (gitignoré). NE PAS committer.
# RAILWAY_API_TOKEN=
# RAILWAY_PROJECT_ID=
# RAILWAY_SERVICE_ID=
# RAILWAY_ENVIRONMENT_ID=
# RAILWAY_PUBLIC_DOMAIN=

# ─── Caps (override DEV uniquement) ───────────────────────────
# Dev override pour le wall-clock cap S04 (cahier §5.3 = 15 s). À ne
# bumper qu'en dev sur des environnements à forte latence (WSL,
# Anthropic global geo, Pappers cold start) où la valeur cahier
# déclenche en permanence des escalades cap_wall_clock. La prod
# Railway EU-West reste à 15 s. Cf. review S05 §I-1.
# WALL_CLOCK_S_OVERRIDE=20
